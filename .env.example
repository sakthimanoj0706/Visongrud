# Twilio Configuration for SMS/WhatsApp Alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=whatsapp:+14155238886  # or your twilio phone number
TWILIO_TO_NUMBER=whatsapp:+1234567890     # or recipient's phone number

# SMTP Configuration for Email Reports
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=recipient@example.com
